{
  "name": "@m-ai/assistant-core",
  "version": "0.1.0",
  "private": true,
  "description": "M.Ai's brain: turns a person's message into answers and confirmed actions over any app that speaks @m-ai/action-contract.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "chat": "tsx scripts/chat.ts"
  },
  "dependencies": {
    "@m-ai/action-contract": "workspace:*"
  },
  "peerDependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@m-ai/mock-erp": "workspace:*",
    "@types/node": "^22.0.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "zod": "4.6.5",
    "tsx": "^4.20.0"
  }
}
