  {
    "name": "today-sales",
    "requires": [
      "today"
    ],
    "turns": [
      {
        "say": "aaj ki sale kitni hui?",
        "expect": {
          "language": "ur-Latn",
          "calls": [
            "reports.sales.summary"
          ],
          "callInput": {
            "reports.sales.summary": {
              "from": "{today}",
              "to": "{today}"
            }
          },
          "figuresFrom": [
            {
              "action": "reports.sales.summary",
              "input": {
                "from": "{today}",
                "to": "{today}"
              },
              "path": "totals.total"
            }
          ]
        }
      }
    ]
  },
