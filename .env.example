# M.Ai — copy this file to .env (same folder) and fill it in.
# .env is git-ignored: your keys never go into the repo.

# ── Which AI model ───────────────────────────────────────────────────────────
# anthropic | openai | zai | groq | gemini | openrouter | ollama | openai-compatible
#   free to start: zai (glm-4.7-flash), groq, gemini — local and free: ollama
M_AI_PROVIDER=zai

# The model id EXACTLY as your provider names it — not a nickname like "haiku".
#   Z.ai, free: glm-4.7-flash, glm-4.5-flash
# List the ids:  pnpm --filter @m-ai/assistant-core models
M_AI_MODEL=glm-4.7-flash

# The key of the provider above (not needed for ollama). Create one in the provider's console:
#   Z.ai https://z.ai/manage-apikey/apikey-list · Groq https://console.groq.com/keys · Gemini https://aistudio.google.com/apikey
# Keep it only in this file. Never paste it into a chat, a ticket or a commit.
M_AI_API_KEY=

# ── More models (optional) ───────────────────────────────────────────────────
# Tried in order when the main model fails (no credit, busy, down). provider:model, comma-separated.
# M_AI_FALLBACK_MODELS=zai:glm-4.5-flash
#
# Your own machine first, then the cloud:
#   M_AI_PROVIDER=ollama
#   M_AI_MODEL=gpt-oss:120b
#   M_AI_BASE_URL=http://192.168.1.50:11434      (the machine's address)
#   M_AI_MAX_CONCURRENT=1                         (more at once spill over to the next model)
#   M_AI_FALLBACK_MODELS=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,zai:glm-4.7-flash
# A machine that is off is skipped at once (checked every 30 s), not after a timeout.

# Keys of other providers, to use them as fallbacks or switch to them at runtime
# (/model in the chat, --model in the evals):
# ZAI_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Ollama needs no key: install it, run "ollama pull qwen3.5:4b", then use ollama:qwen3.5:4b
#   (thinking off unless M_AI_THINKING=on; context length M_AI_NUM_CTX, default 8192)
#   Requests are fitted inside that window. For gpt-oss on your own machine, 16384 gives the
#   assistant all its tools: M_AI_OLLAMA_NUM_CTX=16384 (if the machine has the memory).
# A free cloud plan with a small per-request limit (Groq's free plan: 8000 tokens a minute)
# is learnt from its first "request too large"; or set it: M_AI_GROQ_MAX_INPUT_TOKENS=5500
# Any other OpenAI-compatible server:
# M_AI_OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1

# ── Provider switches (optional) ─────────────────────────────────────────────
# Models can "think" before answering: slower, sometimes more careful. Default off.
# off | on | low | medium | high  (gpt-oss can't stop: off means low)
# M_AI_THINKING=off

# Seconds to wait for one model answer. Default 60 (Z.ai 120, Ollama 300).
# M_AI_TIMEOUT_SECONDS=60

# Anthropic only: if the provider says the key "is not scoped to a workspace",
# either create a key inside a workspace in the Console, or put the workspace id here.
# M_AI_ANTHROPIC_WORKSPACE_ID=

# For openai-compatible as the main provider:
#   Ollama on this computer:  http://localhost:11434/v1
# M_AI_BASE_URL=

# Some OpenAI-compatible servers reject these fields; switch them if you get a 400:
# M_AI_PARALLEL_TOOL_CALLS_PARAM=true
# M_AI_MAX_COMPLETION_TOKENS=false
# Extra request fields, as JSON:
# M_AI_EXTRA_BODY={"think":false}
# Any of these for a provider other than M_AI_PROVIDER: M_AI_<PROVIDER>_<SETTING>,
# e.g. M_AI_ZAI_THINKING=on, M_AI_OPENAI_COMPATIBLE_EXTRA_BODY={...}

# ── What the customer pays (optional) ────────────────────────────────────────
# Each reply's cost (from the prices below) × USD rate × (1 + margin), in this currency.
# M_AI_CURRENCY=PKR
# M_AI_USD_RATE=276.35
# M_AI_MARGIN=20%
# A last line under each reply: the model, this reply's charge and the balance left.
#   off | on | tokens (adds the token count)
# M_AI_USAGE_FOOTER=on

# ── Cost (optional) ──────────────────────────────────────────────────────────
# USD per million tokens, from your provider's price page. Used for the cost
# shown per reply and reported to the app for billing.
# The main model:
# M_AI_PRICE_IN=
# M_AI_PRICE_CACHED=
# M_AI_PRICE_OUT=
# Any model, as provider:model=input/cached/output:
# M_AI_PRICES=groq:openai/gpt-oss-120b=0.15/0.15/0.6; groq:openai/gpt-oss-20b=0.075/0.075/0.3
# Your own machine too (power and hardware), so every reply is charged the same way:
#   ollama:gpt-oss:120b=0.10/0.10/0.40

# ── Extras (optional) ────────────────────────────────────────────────────────
# A folder of extra language packs (*.json), e.g. ./languages
# M_AI_LANGUAGE_PACKS=
# A text file with your software's own guidance for the model.
# M_AI_INSTRUCTIONS_FILE=

# chat / eval check the key and model with the provider before starting.
# M_AI_SKIP_PREFLIGHT=false

# Terminal chat: start as owner | booker | storekeeper, and show every step.
# M_AI_USER=owner
# M_AI_DEBUG=false

# ── A real ERP (chat --erp, eval --erp, erp) ─────────────────────────────────
# The ERP's API; the scripts sign in as a test user and ask it for a delegated
# token for M.Ai, exactly as the web chat will. Nothing here is used otherwise.
# M_AI_ERP_URL=http://localhost:3001
# M_AI_ERP_TENANT=DEMO
# The test users' password (the ERP's DEMO users share one).
# M_AI_ERP_PASSWORD=
# The users, if not the ERP's DEMO defaults:
# M_AI_ERP_OWNER=owner@demo.pk
# M_AI_ERP_BOOKER=zahid@demo.pk
# M_AI_ERP_OFFICER=imran@demo.pk

# ── M.Ai's server: the web chat (pnpm --filter @m-ai/service start) ──────────
# It uses the model settings above, and M_AI_ERP_URL / M_AI_ERP_TENANT for sign-in.
# M_AI_SERVICE_HOST=127.0.0.1      # this machine only (the pilot sign-in holds app sessions)
# M_AI_SERVICE_PORT=3100
# M_AI_PILOT_SIGNIN=on             # on when M_AI_ERP_URL is set; off for apps that send delegated tokens only
# M_AI_LOG_LEVEL=info
